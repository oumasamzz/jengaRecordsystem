{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/reports", "destination": "api/app.py" },
    { "source": "/api/upload", "destination": "api/app.py" },
    { "source": "/api/delete/(.*)", "destination": "api/app.py" },
    { "source": "/api/health", "destination": "api/app.py" },
    { "source": "/(.*)", "destination": "api/app.py" }
  ]
}